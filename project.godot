; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="7 Days of rain"
run/main_scene="res://UI/MainMenu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Clock="*res://Autoloads/clock.gd"
Flags="*res://Autoloads/flags.gd"
Ledger="*res://Autoloads/ledger.gd"
Loop="*res://Autoloads/LOOP.tscn"
Weather="*res://Effects/rain_weather.tscn"
Sound="*res://Autoloads/sound.gd"
Transition="*res://UI/Transition.tscn"
Dialouge="*res://Autoloads/DIALOUGE.tscn"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=720
window/size/window_height_override=480
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom_font="res://Assets/pixel_font.ttf"

