[sub_resource type="Resource" id="Resource_sgo7o"]
script = ExtResource("1_rule")
random_lines = Array[String](["Business business business, numbers, is this working?", "You know what's better than 1 house. 2 houses!", "I think the village folk are starting to catch on...", "Build a house over there! How was that? Did I sound bossy?", "That little brat Mio keeps calling me unko.", "Where is Ume? No not the fruit!", "The rice paddies look good? Will we have a bountiful harvest?", "Wawaweewaa! Head of the town, head of the town. I have 2 houses go do dis go do dat.", "Hypothetically what if I didn't know what I was doing...", "Wait, I'm amazing at this.", "Twa's my father who founded the town!", "Make sure to pray each day! The hot shot says so.", "Why did Hanae have to give birth to a brat like Mio.", "I'm not an idiot I swears it!", "Hehe I think the rain is Shizu-hime's piss.", "Hmmm the dikes are important right?", "Should I start developing a third house? I think I deserve it.", "My father had to rebuild the town after the last flood!", "I just love how easily I get along with all the other villagers.", "The hot shot let me wear his hat hehehe.", "Where is that Tomo? I could use him right now.", "Do you think we need more houses?", "You know I came up with the idea of adding benches (attempts to flex).", "I'm twice the man Kenji will ever be!", "CHIYO IS 80!?!?!?!", "Sometimes I just like rolling in the grass.", "Rain rain go away come back any other day!", "I did my job for the day, can I go play now?", "I swear my house used to be reallyyyy big!", "Hmm Sakura, find out how to make a good town.", "Splish splash I be taking a bath!!!"])
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

