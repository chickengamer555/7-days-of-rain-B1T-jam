[sub_resource type="Resource" id="Resource_cond_evac"]
script = ExtResource("2_cond")
needs_ledger = Array[String](["V3", "R2", "S2"])
to_day = 6
to_phase = 1
metadata/_custom_type_script = "uid://brnj2crn66sd3"

[sub_resource type="Resource" id="Resource_eff_evac"]
script = ExtResource("3_eff")
add_flags = Array[String](["evacuation_ordered"])
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_evac"]
script = ExtResource("4_node")
id = "1"
speaker = "Okabe"
text = "The river has swallowed the sixth stake, and forty years ago this exact rain washed the village away. Everyone, hear me! Pack what you can carry and evacuate to the high ground at the shrine!"
effect = SubResource("Resource_eff_evac")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_evac"]
script = ExtResource("5_tree")
start_id = "1"
nodes = Array[ExtResource("4_node")]([SubResource("Resource_node_evac")])
metadata/_custom_type_script = "uid://1m7x43xe4t0i"

[sub_resource type="Resource" id="Resource_rule_evac"]
script = ExtResource("1_rule")
condition = SubResource("Resource_cond_evac")
tree = SubResource("Resource_tree_evac")
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

[sub_resource type="Resource" id="Resource_rule_fallback"]
script = ExtResource("1_rule")
random_lines = Array[String](["The rain is heavy, but we have weathered storms before.", "We must stay calm until there is clear proof of danger."])
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

