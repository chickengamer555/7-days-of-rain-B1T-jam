[sub_resource type="Resource" id="Resource_jfbd0"]
script = ExtResource("3_x67wf")
id = "1"
speaker = "Kenji"
text = "I'm only leaving to warn my family over yonder. But if this rain breaks the dike… (gulp)."
choices = Array[ExtResource("4_x67wf")]([SubResource("Resource_x67wf")])
effect = SubResource("Resource_6w86x")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_8vtiq"]
script = ExtResource("3_x67wf")
id = "2"
speaker = "Kenji"
text = "Thankfully Tadashi made the dike. I know it's as unbreakable as his spirit!"
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

