[sub_resource type="Resource" id="Resource_node_stay"]
script = ExtResource("3_x67wf")
id = "1"
speaker = "Kenji"
text = "If the river rises, the villagers on the bank will have no way across without my boat. "
choices = Array[ExtResource("4_x67wf")]([SubResource("Resource_vrhvj")])
effect = SubResource("Resource_eff_stay")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_5xl4r"]
script = ExtResource("3_x67wf")
id = "2"
speaker = "Kenji"
text = "I won't run away. I will stay and help everyone escape!"
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

