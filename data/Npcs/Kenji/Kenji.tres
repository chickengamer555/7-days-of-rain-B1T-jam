[sub_resource type="Resource" id="Resource_node_stay"]
script = ExtResource("3_x67wf")
id = "1"
speaker = "Kenji"
text = "You're right... if the river rises, the villagers on the south bank will have no way across without my boat. I won't run away. I will stay and help everyone escape."
effect = SubResource("Resource_eff_stay")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

