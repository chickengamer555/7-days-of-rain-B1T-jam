[sub_resource type="Resource" id="Resource_5gm8v"]
script = ExtResource("3_meevf")
id = "1"
speaker = "Ume"
text = "Ohh that Kenji boy came by for hot tea to which I happily obliged (wink). "
choices = Array[ExtResource("4_fxr04")]([SubResource("Resource_5tdey")])
effect = SubResource("Resource_s2eiy")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_dxbay"]
script = ExtResource("3_meevf")
id = "2"
speaker = "Ume"
text = "He told me he \"intends to take his skiff and leave at dusk in 5 days\". Ohhh Kenji."
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

