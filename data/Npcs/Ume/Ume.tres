effect = SubResource("Resource_p5c2l")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_ahvxl"]
script = ExtResource("3_meevf")
id = "2"
speaker = "Ume"
text = "Ohhh I never saw a single cart of stone. But I did see some glistening pecs. "
