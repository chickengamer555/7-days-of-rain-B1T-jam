[sub_resource type="Resource" id="Resource_qqfsi"]
script = ExtResource("3_6784v")
id = "1"
speaker = "Chiyo"
text = "Forty years ago, the bell rope broke and no one rang it for a month… "
choices = Array[ExtResource("4_xf5eg")]([SubResource("Resource_55wdi")])
effect = SubResource("Resource_8fyys")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_6ys3e"]
script = ExtResource("3_6784v")
id = "2"
speaker = "Chiyo"
text = "The gods were furious… The river nearly swallowed the town whole."
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

