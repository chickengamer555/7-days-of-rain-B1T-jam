[sub_resource type="Resource" id="Resource_f3stg"]
script = ExtResource("1_mlhc1")
random_lines = Array[String](["... I remember it so clearly.", "... It was 40 years ago wasn't it?", "... Why... did we really deserve such punishment?", "... Kenji's poor father... the boat capsized.", "... We never knew... the bell.", "... I think... my age is getting to me.", "... I remember Ume... she was a sweet little girl.", "... Shizu-hime... Shizu-hime.", "... We must pray... it's all we can do.", "... She's imprisoned... I couldn't help her.", "... Mio came by... reminds me of Ume.", "... Sometimes I see him... Kenji's father... Living in him.", "... If only we knew...", "... Kuro and Mio... such good friends.", "... Tadashi... is Selena okay?", "...Sato... he always was fascinated by that river.", "... I think... Genshin was born with his hat.", "... Okabe's father... was much better.", "... Do the judges... like this game?", "... What will I have for dinner?", "... Hanae as a baby... and now a mother!", "... The days pass by... am I content?", "... Please... don't let it happen again.", "... Shizu-hime... I'm sorry.", "... Oh kami... forgive us.", "... Make sure you pray.", "... Tomo... He has a pure heart... he has lived.", "...These days it gets harder... to function.", "... This town... is my home... it should be a home... for others.", "... The rice fields... I hope to see next harvest.", "... Hope... It's all we have."])
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

