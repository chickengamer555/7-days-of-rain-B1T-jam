[sub_resource type="Resource" id="Resource_rule_fallback"]
script = ExtResource("1_u7fii")
random_lines = Array[String](["Blahh THE RAIN IS AWESOME!", "Me and Kuro are splashing in puddles.", "My grandmother will save us!", "Woahhh the river was running so fast.", "Do you think Kenji will let me ride his boat?", "Genshins stupid, Okabe stupid.", "Grandma told me we must always pray to Shizu-hime.", "I like the rain but not when it goes on for this long.", "Shizu-hime, Shizu-hime, Shizu-hime!!!", "Ume's so cool she gives me free drinks!", "Where's Tadashi I want a piggy back ride.", "Sato speaks to the river hehehe.", "Grandma tell mes not to grow up like Ume.", "SPLASH SPLASH SPLASH.", "I wanna grow up to be like grandma.", "Kenji says I can be anything when I grow up!", "Tadashi awesome! Okabe unko!", "Kuro's my best friend!", "Kuro go steal Kenji's bacon!", "I want to wear Genshin's hat...", "The mountain is HUGEEEEE!!!", "I hope we can help Shizu-hime.", "I'm gonna save the village one day!!!", "What's a hot shot?", "La La La La Lahhhhhhh.", "Sato awesome! Kenji awesome!", "I like Tomo because he helps me pray!", "Uh, Shizu-hime please protect the village and Kuro.", "I get to play all day!!!", "I can't wait for the rice to be done.", "I like the memorial it's a cooooool stone thingy."])
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

