[resource]
script = ExtResource("1_1dcci")
id = "true_ending"
trigger = "true_ending"
card_text = "On the seventh evening, the stone dike held.
Everyone in the village is safe on the hill.

You ring the bell with Mio and say:
'We can stand now, thank you.'

The rain stops and the sun comes out.
The spirit can finally rest. You broke the loop."
