[sub_resource type="Resource" id="Resource_choice_1"]
script = ExtResource("4_choice")
next_id = "2"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_1"]
script = ExtResource("3_node")
id = "1"
speaker = "West Stair"
text = "You push aside tangled ivy and moss covering the abandoned west staircase."
choices = Array[ExtResource("4_choice")]([SubResource("Resource_choice_1")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_choice_2"]
script = ExtResource("4_choice")
next_id = "3"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_2"]
script = ExtResource("3_node")
id = "2"
speaker = "Stair Stones"
text = "Beneath the weeds lie tiers of heavy, finely dressed granite blocks."
choices = Array[ExtResource("4_choice")]([SubResource("Resource_choice_2")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_eff_e5"]
script = ExtResource("2_eff")
add_ledger = Array[String](["E5"])
add_flags = Array[String](["found_stair_stones"])
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_3"]
script = ExtResource("3_node")
id = "3"
speaker = "Stair Stones"
text = "Over a hundred flat stones rest here. If moved, they could face the entire dike."
effect = SubResource("Resource_eff_e5")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_stones"]
script = ExtResource("5_tree")
start_id = "1"
nodes = Array[ExtResource("3_node")]([SubResource("Resource_node_1"), SubResource("Resource_node_2"), SubResource("Resource_node_3")])
metadata/_custom_type_script = "uid://1m7x43xe4t0i"

[sub_resource type="Resource" id="Resource_rule_stones"]
script = ExtResource("1_rule")
tree = SubResource("Resource_tree_stones")
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

[resource]
script = ExtResource("6_data")
id = "stair_stone"
