[sub_resource type="Resource" id="Resource_node_1"]
script = ExtResource("2_node")
id = "1"
speaker = "Shrine"
text = "An ancient brass hourglass stands upon a weathered pedestal near the bell."
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice_1")])
