metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_3"]
script = ExtResource("4_node")
id = "3"
speaker = "Cost Book"
text = "Timber: paid. Bamboo: paid. Mud: paid. Stone facing: entry crossed out."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_3")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_eff_e3"]
