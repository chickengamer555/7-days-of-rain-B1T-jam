add_ledger = Array[String](["E3"])
add_flags = Array[String](["has_cost_book"])
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_4"]
script = ExtResource("4_node")
id = "4"
speaker = "Cost Book"
text = "The stone was never ordered. The dike was built only from mud and bamboo."
effect = SubResource("Resource_eff_e3")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_found"]
script = ExtResource("6_tree")
