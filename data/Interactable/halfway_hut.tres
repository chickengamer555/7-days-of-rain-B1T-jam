[sub_resource type="Resource" id="Resource_node_1"]
script = ExtResource("4_node")
id = "1"
speaker = "Mountain Trail"
text = "Guided by barking in the trees, you reach the crude timber shelter."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_1")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_node_2"]
script = ExtResource("4_node")
id = "2"
speaker = "Trail Shelter"
text = "Mio huddles under the eaves, shivering in her sodden coat with Kuro beside her."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_2")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_node_3"]
script = ExtResource("4_node")
id = "3"
speaker = "Trail Shelter"
text = "She clutches Haruko's bell-cord tightly. You reassure her and bring her to safety."
effect = SubResource("Resource_eff_hut")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_d6"]
