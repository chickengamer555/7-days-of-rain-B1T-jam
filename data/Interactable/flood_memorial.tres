next_id = "5"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_8dfe0"]
script = ExtResource("3_node")
id = "4"
speaker = "Memorial"
text = "Among the carved names is Kenji's father. Kenji was only a boy when it happened."
choices = Array[ExtResource("4_choice")]([SubResource("Resource_ojl1v")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tvbof"]
script = ExtResource("3_node")
id = "5"
speaker = "Memorial"
text = "It also talks about 'Asterupnorth, the one who paved the village'"
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_memorial"]
