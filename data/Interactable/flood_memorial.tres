[sub_resource type="Resource" id="Resource_node_3"]
script = ExtResource("3_node")
id = "3"
speaker = "Memorial"
text = "'Their deaths took place when the bell fell silent for a month.'"
choices = Array[ExtResource("4_choice")]([SubResource("Resource_ndgaa")])
effect = SubResource("Resource_eff_memorial")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_ojl1v"]
