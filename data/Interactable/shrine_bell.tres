[gd_resource type="Resource" script_class="InteractbleData" format=3 uid="uid://bd0k76uifghcr"]

[ext_resource type="Script" uid="uid://dn6pv6t3qvn8d" path="res://data/classes/CONVERSATIOM_RULE.gd" id="1_rule"]
[ext_resource type="Script" uid="uid://brnj2crn66sd3" path="res://data/classes/CONDITION.gd" id="2_cond"]
[ext_resource type="Script" uid="uid://bi35u3p34l30b" path="res://data/classes/EFFECT.gd" id="3_eff"]
[ext_resource type="Script" uid="uid://c3bdbn2jbepsa" path="res://Dialouge-Prewritten/dialogue_node.gd" id="4_node"]
[ext_resource type="Script" uid="uid://bocbuuj64elde" path="res://Dialouge-Prewritten/dialogue_choice.gd" id="5_choice"]
[ext_resource type="Script" uid="uid://1m7x43xe4t0i" path="res://Dialouge-Prewritten/dialogue_tree.gd" id="6_tree"]
[ext_resource type="Script" uid="uid://dnqtpl4ogoqlq" path="res://data/classes/INTERACTABLE_DATA.gd" id="7_data"]
[ext_resource type="Texture2D" uid="uid://mkvf3td8yfp2" path="res://Assets/Interactable/Bellrope.png" id="8_yeh7d"]

[sub_resource type="Resource" id="Resource_cond_true_end"]
script = ExtResource("2_cond")
needs_ledger = Array[String](["S6"])
needs_flags = Array[String](["dike_repaired", "evacuation_ordered", "mio_safe"])
metadata/_custom_type_script = "uid://brnj2crn66sd3"

[sub_resource type="Resource" id="Resource_choice_te_1"]
script = ExtResource("5_choice")
next_id = "2"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_te_1"]
script = ExtResource("4_node")
id = "1"
speaker = "Shrine Bell"
text = "The seventh dusk has come. The river roars in the distance, but the dike stands firm."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_te_1")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_choice_te_2"]
script = ExtResource("5_choice")
next_id = "3"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_te_2"]
script = ExtResource("4_node")
id = "2"
speaker = "Shrine Bell"
text = "Mio grasps the braided cord beside you. The village is safe on the heights."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_te_2")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_choice_te_3"]
script = ExtResource("5_choice")
next_id = "4"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_te_3"]
script = ExtResource("4_node")
id = "3"
speaker = "You"
text = "Together, you ring the great bell and speak the words: 'We can stand now, thank you.'"
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_te_3")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_eff_true_end"]
script = ExtResource("3_eff")
add_flags = Array[String](["true_ending_triggered"])
ending_trigger = "true_ending"
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_te_4"]
script = ExtResource("4_node")
id = "4"
speaker = "Shizu-hime"
text = "A gentle warmth stirs through the rain: '...Is it true? Then the promise is fulfilled.'"
effect = SubResource("Resource_eff_true_end")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_true_end"]
script = ExtResource("6_tree")
start_id = "1"
nodes = Array[ExtResource("4_node")]([SubResource("Resource_node_te_1"), SubResource("Resource_node_te_2"), SubResource("Resource_node_te_3"), SubResource("Resource_node_te_4")])
metadata/_custom_type_script = "uid://1m7x43xe4t0i"

[sub_resource type="Resource" id="Resource_rule_true_end"]
script = ExtResource("1_rule")
condition = SubResource("Resource_cond_true_end")
tree = SubResource("Resource_tree_true_end")
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

[sub_resource type="Resource" id="Resource_choice_ring"]
script = ExtResource("5_choice")
label = "Ring the bell now (Reset loop)"
next_id = "ring"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_choice_leave"]
script = ExtResource("5_choice")
label = "Step away"
next_id = "leave"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_ring_prompt"]
script = ExtResource("4_node")
id = "1"
speaker = "Shrine Bell"
text = "The sacred bronze bell of Hinoe Shrine. The braided cord rests in your hand."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_ring"), SubResource("Resource_choice_leave")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_eff_reset"]
script = ExtResource("3_eff")
ending_trigger = "early_reset"
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_ring_action"]
script = ExtResource("4_node")
id = "ring"
speaker = "Shrine Bell"
text = "You pull the rope. A deep, solemn chime echoes across the drowned valley..."
effect = SubResource("Resource_eff_reset")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_node_leave_action"]
script = ExtResource("4_node")
id = "leave"
speaker = "Shrine Bell"
text = "You release the hemp rope and step back."
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_normal"]
script = ExtResource("6_tree")
start_id = "1"
nodes = Array[ExtResource("4_node")]([SubResource("Resource_node_ring_prompt"), SubResource("Resource_node_ring_action"), SubResource("Resource_node_leave_action")])
metadata/_custom_type_script = "uid://1m7x43xe4t0i"

[sub_resource type="Resource" id="Resource_rule_normal"]
script = ExtResource("1_rule")
tree = SubResource("Resource_tree_normal")
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

[resource]
script = ExtResource("7_data")
id = "shrine_bell"
display_name = "Shrine Bell"
sprite = ExtResource("8_yeh7d")
rules = Array[ExtResource("1_rule")]([SubResource("Resource_rule_true_end"), SubResource("Resource_rule_normal")])
metadata/_custom_type_script = "uid://dnqtpl4ogoqlq"
