[sub_resource type="Resource" id="Resource_cond_s3"]
script = ExtResource("2_cond")
needs_ledger = Array[String](["S3"])
metadata/_custom_type_script = "uid://brnj2crn66sd3"

[sub_resource type="Resource" id="Resource_choice_1"]
script = ExtResource("5_choice")
next_id = "2"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_1"]
script = ExtResource("4_node")
id = "1"
speaker = "Inner Room"
text = "Remembering what Tomo said, you look behind the offering screen."
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_1")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_choice_2"]
script = ExtResource("5_choice")
next_id = "3"
metadata/_custom_type_script = "uid://bocbuuj64elde"

[sub_resource type="Resource" id="Resource_node_2"]
script = ExtResource("4_node")
id = "2"
speaker = "Haruko's Journal"
text = "'The shrine stands because the village stands. We do not ring for glory, but to keep the water still.'"
choices = Array[ExtResource("5_choice")]([SubResource("Resource_choice_2")])
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_eff_journal"]
script = ExtResource("3_eff")
add_ledger = Array[String](["S4", "S5"])
add_flags = Array[String](["read_journal"])
metadata/_custom_type_script = "uid://bi35u3p34l30b"

[sub_resource type="Resource" id="Resource_node_3"]
script = ExtResource("4_node")
id = "3"
speaker = "Haruko's Journal"
text = "The final page is dated six months ago: 'Grant them one more rain to see them through.'"
effect = SubResource("Resource_eff_journal")
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_journal"]
script = ExtResource("6_tree")
start_id = "1"
nodes = Array[ExtResource("4_node")]([SubResource("Resource_node_1"), SubResource("Resource_node_2"), SubResource("Resource_node_3")])
metadata/_custom_type_script = "uid://1m7x43xe4t0i"

[sub_resource type="Resource" id="Resource_rule_journal"]
script = ExtResource("1_rule")
condition = SubResource("Resource_cond_s3")
tree = SubResource("Resource_tree_journal")
metadata/_custom_type_script = "uid://dn6pv6t3qvn8d"

[sub_resource type="Resource" id="Resource_node_fallback"]
script = ExtResource("4_node")
id = "1"
speaker = "Inner Altar"
text = "A quiet alcove behind the shrine screen. The air smells of old incense and rain."
metadata/_custom_type_script = "uid://c3bdbn2jbepsa"

[sub_resource type="Resource" id="Resource_tree_fallback"]
script = ExtResource("6_tree")
start_id = "1"
nodes = Array[ExtResource("4_node")]([SubResource("Resource_node_fallback")])
